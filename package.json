{
  "name": "super-pro-ai-office-manager",
  "version": "19.0.0",
  "description": "Multi-tenant AI office manager for Australian service businesses: workforce compliance (Fair Work, VEVO), omnichannel inbox with human-approved AI drafts, job ledger and a tamper-evident audit trail.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umerfaizan92/fleet-office-ai.git"
  },
  "keywords": [
    "office-manager",
    "workforce-compliance",
    "fair-work",
    "vevo",
    "privacy-act",
    "omnichannel",
    "ai-assistant",
    "sqlite",
    "render"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node --watch src/server.js",
    "test": "node scripts/verify-all.mjs",
    "test:fast": "node scripts/verify-all.mjs --fast",
    "test:unit": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "check:config": "node scripts/check-config.mjs",
    "validate": "node scripts/validate-release.mjs",
    "quality:check": "node scripts/quality-check.mjs && node scripts/quality-ratchet.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "integration:test": "node scripts/test-integrations.mjs",
    "generate:admin-key": "node scripts/generate-admin-key.mjs",
    "generate:operator-mfa": "node scripts/generate-operator-mfa.mjs",
    "manifest:update": "node scripts/update-manifest.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "postinstall": "node scripts/install-litestream.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "storage:verify": "node scripts/verify-storage.mjs",
    "backup:restore-drill": "node scripts/restore-drill.mjs",
    "deploy:check": "node scripts/post-deploy-check.mjs",
    "build:ds": "node scripts/build-ds.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/build-site.mjs --check",
    "test:site-ui": "node scripts/test-site-ui.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update",
    "report:a11y-perf": "node scripts/report-a11y-perf.mjs",
    "memory:resume": "node scripts/memory/resume.mjs",
    "memory:checkpoint": "node scripts/memory/checkpoint.mjs",
    "memory:snapshot": "node scripts/memory/snapshot.mjs",
    "memory:restore": "node scripts/memory/restore.mjs",
    "memory:validate": "node scripts/memory/validate.mjs",
    "memory:task": "node scripts/memory/task.mjs",
    "test:pipeline-ui": "node scripts/test-pipeline-ui.mjs",
    "test:console-ui": "node scripts/test-console-platform.mjs",
    "verify:modules": "node scripts/verify-modules.mjs",
    "test:automations-ui": "node scripts/test-automations-ui.mjs",
    "test:seo-ui": "node scripts/test-seo-ui.mjs",
    "test:comms-ui": "node scripts/test-comms-ui.mjs",
    "test:finance-ui": "node scripts/test-finance-ui.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "better-sqlite3": "12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.9",
    "qrcode": "^1.5.4",
    "resend": "^6.28.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "three": "0.186.1"
  }
}

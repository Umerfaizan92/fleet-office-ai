{
  "name": "super-pro-ai-office-manager",
  "version": "19.0.0",
  "description": "Multi-tenant AI office manager for Australian service businesses: workforce compliance (Fair Work, VEVO), omnichannel inbox with human-approved AI drafts, job ledger and a tamper-evident audit trail.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umerfaizan92/fleet-office-ai.git"
  },
  "keywords": [
    "office-manager",
    "workforce-compliance",
    "fair-work",
    "vevo",
    "privacy-act",
    "omnichannel",
    "ai-assistant",
    "sqlite",
    "render"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node --watch src/server.js",
    "test": "node scripts/verify-all.mjs",
    "test:fast": "node scripts/verify-all.mjs --fast",
    "test:unit": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "check:config": "node scripts/check-config.mjs",
    "validate": "node scripts/validate-release.mjs",
    "quality:check": "node scripts/quality-check.mjs && node scripts/quality-ratchet.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "integration:test": "node scripts/test-integrations.mjs",
    "generate:admin-key": "node scripts/generate-admin-key.mjs",
    "generate:operator-mfa": "node scripts/generate-operator-mfa.mjs",
    "manifest:update": "node scripts/update-manifest.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "postinstall": "node scripts/install-litestream.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "better-sqlite3": "12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.9",
    "qrcode": "^1.5.4",
    "resend": "^6.28.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "qs": "^6.15.4"
  }
}

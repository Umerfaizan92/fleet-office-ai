# Super Pro AI Office Manager environment template
# Copy to .env for local development. Never commit real secret values.

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/fleet-parlour.sqlite
UPLOAD_DIR=./uploads
MAX_FILE_MB=25
MAX_FILES=10
ALLOWED_ORIGINS=http://localhost:3000

# Security
ADMIN_API_KEY=generate-a-long-random-key
SESSION_SECRET=
SAAS_SESSION_SECRET=
ADMIN_SESSION_SECRET=
AI_TOOL_SHARED_SECRET=

# SaaS verification and lifecycle
SAAS_VERIFICATION_TEST_MODE=0
SAAS_VERIFY_FROM=
TRIAL_DAYS=14
POST_TRIAL_RESTRICT_DAYS=30
ARCHIVE_RETENTION_DAYS=365
FINAL_RESTORE_WINDOW_DAYS=14
ABR_GUID=
TELNYX_VERIFY_PROFILE_ID=

# AI provider
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_CHECKER_PROVIDER_BASE_URL=
AI_CHECKER_API_KEY=
AI_CHECKER_MODEL=
